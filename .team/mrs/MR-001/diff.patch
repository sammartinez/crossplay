+import { vi } from 'vitest'
+
+// Makes every localStorage call throw, as Safari private mode and blocked
+// site data do. Undone by vi.restoreAllMocks() in setup.ts.
+export function makeStorageThrow(): void {
+  const fail = () => {
+    throw new DOMException('storage blocked', 'SecurityError')
+  }
+  vi.spyOn(Storage.prototype, 'getItem').mockImplementation(fail)
+  vi.spyOn(Storage.prototype, 'setItem').mockImplementation(fail)
+  vi.spyOn(Storage.prototype, 'removeItem').mockImplementation(fail)
+}
diff --git a/src/test/systemTheme.ts b/src/test/systemTheme.ts
new file mode 100644
index 0000000..d21dfea
--- /dev/null
+++ b/src/test/systemTheme.ts
@@ -0,0 +1,28 @@
+// jsdom has no matchMedia. These helpers stand in for the OS colour-scheme
+// setting so tests can say which theme the system prefers.
+type SystemTheme = 'light' | 'dark'
+
+const DARK_QUERY = /prefers-color-scheme:\s*dark/
+const LIGHT_QUERY = /prefers-color-scheme:\s*light/
+
+export function mockSystemTheme(theme: SystemTheme): void {
+  const matchMedia = (query: string): MediaQueryList => ({
+    matches: theme === 'dark' ? DARK_QUERY.test(query) : LIGHT_QUERY.test(query),
+    media: query,
+    onchange: null,
+    addListener: () => {},
+    removeListener: () => {},
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    dispatchEvent: () => false,
+  })
+  Object.defineProperty(window, 'matchMedia', {
+    configurable: true,
+    writable: true,
+    value: matchMedia,
+  })
+}
+
+export function resetSystemTheme(): void {
+  mockSystemTheme('light')
+}
