{
  "baseBranch": "claude/eng-team-command-bepn8k",
  "commands": {
    "test": "npm test",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "preview": "npm run dev"
  },
  "previewUrl": "http://localhost:5173/crossplay",
  "testPaths": [
    "tests/",
    "__tests__/",
    "**/*.test.*",
    "**/*.spec.*",
    "vitest.config.*",
    "vitest.setup.*",
    "jest.config.*",
    "jest.setup.*",
    "setupTests.*",
    "playwright.config.*",
    "src/test/"
  ],
  "paths": {
    "constants": "src/constants.ts",
    "shared": "src/lib/"
  },
  "maxReviewRounds": 3
}
